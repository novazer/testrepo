{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "src/*": ["./src/*"] }
  },
  "include": ["src", "scripts", "vitest.config.ts"]
}
